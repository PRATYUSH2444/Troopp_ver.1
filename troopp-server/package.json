{
  "name": "troopp-server",
  "version": "1.0.0",
  "description": "Troopp core backend server platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate --config src/config/sequelize.cjs --migrations-path src/database/migrations",
    "seed": "sequelize-cli db:seed:all --config src/config/sequelize.cjs --seeders-path src/database/seeders",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.500.0",
    "@sentry/node": "^10.63.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^18.7.0",
    "firebase-admin": "^11.11.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^6.0.1",
    "sequelize": "^6.33.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1",
    "supertest": "^6.3.3"
  }
}
